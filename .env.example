# Supabase Configuration
# URL proyek Supabase Anda (ditemukan di Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon Key Supabase Anda (ditemukan di Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Chatbot Configuration (Groq Cloud API Key)
# Kunci API Groq Cloud untuk menjalankan chatbot Coura AI
VITE_GROQ_API_KEY=gsk_your-groq-cloud-api-key

# EmailJS Service Configuration
# Digunakan untuk mengirim notifikasi email otomatis saat ada pesan baru di Guestbook atau formulir kontak
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-contact-form-template-id
VITE_EMAILJS_GUESTBOOK_TEMPLATE_ID=your-guestbook-notification-template-id

# Google Analytics Setup
# ID Pengukuran Google Analytics 4 (GA4) untuk melacak statistik pengunjung
VITE_GA_MEASUREMENT_ID=G-your-google-analytics-id
